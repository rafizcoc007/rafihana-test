          {/* Action Icons Right */}
          <div className="flex items-center gap-3 sm:gap-4">
            {currentView === 'store' ? (
              <>
                <button 
                  onClick={() => triggerToast(`Wishlist has ${wishlist.length} item(s)`)}
                  className="relative p-2.5 rounded-full text-slate-600 hover:bg-slate-100 transition"
